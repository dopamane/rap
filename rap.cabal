cabal-version:      3.0
name:               rap
version:            0.1.0.0
synopsis:           Resource Interchange File Format (RIFF)
description:        RIFF expression language
homepage:           https://github.com/dopamane/rap
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

source-repository head
  type: git
  location: https://github.com/dopamane/rap

library
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  hs-source-dirs:   lib
  exposed-modules:  Data.Rap
  build-depends:
    base < 5,
    binary,
    bytestring

executable rap
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   exe
  main-is:          Main.hs
  other-modules:    Paths_rap
  autogen-modules:  Paths_rap
  build-depends:
    base < 5,
    rap

test-suite test
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:
    base < 5,
    binary,
    bytestring,
    rap,
    tasty,
    tasty-hunit
